# Copy to .env.local and fill in your SMTP details.
# Enquiries from the website will be emailed to ENQUIRY_NOTIFY_EMAIL.

# Where enquiries are delivered (comma-separated)
ENQUIRY_NOTIFY_EMAIL=enquiry@tapisglobalinternational.com,sales@tapisglobalinternational.com

# SMTP — Gmail example (use an App Password, not your normal password)
# https://support.google.com/accounts/answer/185833
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your-email@gmail.com
SMTP_PASS=your-app-password-here
SMTP_FROM=your-email@gmail.com
SMTP_FROM_NAME=Tapis Global Website

# Other providers: use their SMTP host/port (e.g. Outlook, Zoho, cPanel mail)

# ─────────────────────────────────────────────────────────────────────────────
# Analytics & TARA (all OPTIONAL — the site builds/runs with these absent).
# ─────────────────────────────────────────────────────────────────────────────

# GA4 Measurement ID (public by design). Absent => GA4 not loaded, no events.
NEXT_PUBLIC_GA_MEASUREMENT_ID=

# Microsoft Clarity project ID (public). Absent => Clarity not loaded.
NEXT_PUBLIC_CLARITY_PROJECT_ID=

# Analytics dispatch mode. Unset/'gtag' (default) = direct GA4 via gtag.js.
# Set 'gtm' ONLY if a Google Tag Manager container is installed (events go to
# dataLayer instead). The two modes are never mixed.
NEXT_PUBLIC_ANALYTICS_MODE=

# TARA AI Rug Advisor — Anthropic API key (server-only secret). Absent =>
# TARA runs in deterministic guided mode (category/material discovery + lead
# capture still work; no AI free-text). NEVER expose this to the browser.
ANTHROPIC_API_KEY=
# Optional model override (defaults to a fast Haiku model).
TARA_MODEL=
# TARA abuse/cost protection (optional — safe defaults shown).
TARA_MAX_AI_TURNS_PER_SESSION=15
TARA_MAX_REQUESTS_PER_MINUTE=20
TARA_TIMEOUT_MS=15000
# Optional signing secret for the per-session AI-turn cookie. If unset, a stable
# server-only hash of ANTHROPIC_API_KEY is used. Server-only; never public.
TARA_SESSION_SECRET=
