# Copy to .env.local and fill in your SMTP details.
# Enquiries from the website will be emailed to ENQUIRY_NOTIFY_EMAIL.

# Where enquiries are delivered (comma-separated)
ENQUIRY_NOTIFY_EMAIL=enquiry@tapisglobalinternational.com,sales@tapisglobalinternational.com

# SMTP — Gmail example (use an App Password, not your normal password)
# https://support.google.com/accounts/answer/185833
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your-email@gmail.com
SMTP_PASS=your-app-password-here
SMTP_FROM=your-email@gmail.com
SMTP_FROM_NAME=Tapis Global Website

# Other providers: use their SMTP host/port (e.g. Outlook, Zoho, cPanel mail)
