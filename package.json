    "seo:audit": "node scripts/seo-audit.mjs",
    "seo:audit:production": "node scripts/seo-audit-production.mjs",
    "seo:audit:production:test": "node scripts/seo-audit-production.test.mjs",
    "optimize:images": "node scripts/optimize-images.mjs && node scripts/replace-image-paths.mjs",
    "analyze": "ANALYZE=true next build",
    "test:leads": "node scripts/lead-intelligence.test.mjs",
    "test:tara": "node scripts/tara-guard.test.mjs && node scripts/tara-conversation-ux.test.mjs && node scripts/tara-sales-consultant.test.mjs && node scripts/tara-provider-fallback.test.mjs && node scripts/tara-conversational-intelligence.test.mjs && node scripts/tara-recommendation.test.mjs && node scripts/tara-product-knowledge.test.mjs",
    "test:tara:intel": "node scripts/tara-recommendation.test.mjs",
    "test:tara:knowledge": "node scripts/tara-product-knowledge.test.mjs",
    "test:phase": "node scripts/phase-fixes.test.mjs",
    "test:content": "node scripts/content-engine.test.mjs",
    "test:crafttrack": "node scripts/crafttrack-journey-creation.test.mjs && node scripts/crafttrack-publish-stage.test.mjs && node scripts/crafttrack-notification.test.mjs && node scripts/crafttrack-published-journey-view.test.mjs && node scripts/crafttrack-login-rate-limit.test.mjs",
    "knowledge:validate": "node scripts/validate-knowledge.mjs",
    "prebuild": "node scripts/validate-knowledge.mjs",
    "postinstall": "prisma generate",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:seed": "prisma db seed",
    "db:studio": "prisma studio"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  },
  "dependencies": {
    "@prisma/client": "^6.19.3",
    "@vercel/blob": "^2.6.1",
    "bcryptjs": "^3.0.3",
